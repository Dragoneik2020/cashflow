<!-- views/admin/import-db.ejs -->
<%- include('../partials/header') %>
<h1 class="text-2xl font-bold mb-4">Importar base de datos local</h1>
<p class="text-gray-500 mb-4 text-sm">Solo super admin. Pega aquí el contenido de tu archivo <code>data/db.json</code> local para migrar negocios y usuarios a este servidor.</p>

<% if (mensaje) { %>
  <div class="bg-green-50 border border-green-200 text-green-800 px-4 py-3 rounded mb-4 text-sm"><%= mensaje %></div>
<% } %>
<% if (error) { %>
  <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded mb-4 text-sm"><%= error %></div>
<% } %>

<form action="/admin/import-db" method="POST" class="bg-white rounded-lg shadow p-6 space-y-4">
  <div>
    <label class="block text-sm font-medium mb-1">Contenido de db.json</label>
    <textarea name="json" rows="20" class="w-full border rounded px-3 py-2 font-mono text-xs" placeholder="{ &quot;tenants&quot;: [...], &quot;users&quot;: [...] }"></textarea>
  </div>
  <div class="flex gap-2">
    <button class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded" onclick="return confirm('¿Sobrescribir la base de datos del servidor con este contenido?')">Importar</button>
    <a href="/superadmin" class="px-4 py-2 rounded border">Cancelar</a>
  </div>
</form>
<%- include('../partials/footer') %>
