<!-- views/pedidos/index.ejs -->
<%- include('../partials/header') %>
<div class="flex items-center justify-between mb-4">
  <h1 class="text-2xl font-bold">Pedidos</h1>
  <div class="space-x-2">
    <a href="/export/pedidos" class="bg-gray-600 hover:bg-gray-700 text-white px-3 py-2 rounded text-sm">Exportar CSV</a>
    <a href="/pedidos/importar" class="bg-amber-600 hover:bg-amber-700 text-white px-3 py-2 rounded text-sm">Importar CSV</a>
    <a href="/pedidos/nuevo" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded">+ Nuevo</a>
  </div>
</div>
<div id="pedidos-table" class="bg-white rounded-lg shadow overflow-x-auto"
     hx-get="/pedidos" hx-select="#pedidos-table" hx-target="#pedidos-table" hx-swap="outerHTML" hx-trigger="every 20s[document.visibilityState=='visible' && !document.querySelector('input:focus,textarea:focus,select:focus')]">
  <table class="w-full text-sm">
    <thead class="bg-gray-50 text-gray-600">
      <tr>
        <th class="text-left p-3">Fecha</th>
        <th class="text-left p-3">Proveedor</th>
        <th class="text-left p-3">Descripción</th>
        <th class="text-right p-3">Cant.</th>
        <th class="text-right p-3">P. Unit</th>
        <th class="text-right p-3">Total</th>
        <th class="text-left p-3">Estado</th>
        <th class="p-3"></th>
      </tr>
    </thead>
    <tbody>
      <% pedidos.forEach(p => { %>
      <tr class="border-t hover:bg-gray-50">
        <td class="p-3"><%= p.fecha %></td>
        <td class="p-3"><%= p.proveedor %></td>
        <td class="p-3"><%= p.descripcion %></td>
        <td class="p-3 text-right"><%= p.cantidad %></td>
        <td class="p-3 text-right"><%= money(p.precioUnit) %></td>
        <td class="p-3 text-right font-medium"><%= money(p.total) %></td>
        <td class="p-3">
          <form action="/pedidos/<%= p._row %>/estado" method="POST" class="inline">
            <select name="estado" onchange="this.form.submit()" class="border rounded px-2 py-1 text-xs">
              <% ['Pendiente','En proceso','Completado','Cancelado'].forEach(e => { %>
                <option value="<%= e %>" <%= p.estado===e?'selected':'' %>><%= e %></option>
              <% }) %>
            </select>
          </form>
        </td>
        <td class="p-3 text-right space-x-1">
          <a href="/pedidos/<%= p._row %>/edit" class="text-blue-600 hover:underline text-xs">Editar</a>
          <% if (!convertidos.has(p.id)) { %>
          <form action="/pedidos/<%= p._row %>/convertir-ingreso" method="POST" class="inline" onsubmit="return confirm('¿Pasar el monto del pedido a Ingresos?')">
            <button class="text-green-600 hover:underline text-xs">→ Ingreso</button>
          </form>
          <% } else { %>
          <span class="text-green-600 text-xs">✓ Ingreso</span>
          <% } %>
          <form action="/pedidos/<%= p._row %>" method="POST" class="inline" onsubmit="return confirm('¿Eliminar pedido?')">
            <input type="hidden" name="_method" value="DELETE" />
            <button class="text-red-600 hover:underline text-xs">Eliminar</button>
          </form>
        </td>
      </tr>
      <% }) %>
      <% if (!pedidos.length) { %><tr><td colspan="8" class="text-center text-gray-400 py-6">Sin pedidos</td></tr><% } %>
    </tbody>
  </table>
</div>
<%- include('../partials/footer') %>
