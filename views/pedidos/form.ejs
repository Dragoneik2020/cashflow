<!-- views/pedidos/form.ejs -->
<%- include('partials/header') %>
<h1 class="text-2xl font-bold mb-4">Nuevo pedido</h1>
<form action="<%= action %>" method="POST" class="bg-white rounded-lg shadow p-6 max-w-2xl space-y-4">
  <div class="grid grid-cols-2 gap-4">
    <div>
      <label class="block text-sm font-medium mb-1">Fecha</label>
      <input type="date" name="fecha" value="<%= new Date().toISOString().slice(0,10) %>" class="w-full border rounded px-3 py-2" />
    </div>
    <div>
      <label class="block text-sm font-medium mb-1">Proveedor</label>
      <select name="proveedorId" class="w-full border rounded px-3 py-2">
        <option value="">-- Seleccionar --</option>
        <% proveedores.forEach(p => { %>
          <option value="<%= p.id %>"><%= p.nombre %></option>
        <% }) %>
      </select>
    </div>
  </div>
  <div>
    <label class="block text-sm font-medium mb-1">Descripción *</label>
    <input name="descripcion" required class="w-full border rounded px-3 py-2" />
  </div>
  <div class="grid grid-cols-3 gap-4">
    <div>
      <label class="block text-sm font-medium mb-1">Cantidad</label>
      <input type="number" step="0.01" name="cantidad" value="1" class="w-full border rounded px-3 py-2" />
    </div>
    <div>
      <label class="block text-sm font-medium mb-1">Precio unitario</label>
      <input type="number" step="0.01" name="precioUnit" value="0" class="w-full border rounded px-3 py-2" />
    </div>
    <div>
      <label class="block text-sm font-medium mb-1">Estado</label>
      <select name="estado" class="w-full border rounded px-3 py-2">
        <option>Pendiente</option><option>En proceso</option><option>Completado</option><option>Cancelado</option>
      </select>
    </div>
  </div>
  <div>
    <label class="block text-sm font-medium mb-1">Notas</label>
    <textarea name="notas" rows="2" class="w-full border rounded px-3 py-2"></textarea>
  </div>
  <div class="flex gap-2">
    <button class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded">Guardar</button>
    <a href="/pedidos" class="px-4 py-2 rounded border">Cancelar</a>
  </div>
</form>
<%- include('partials/footer') %>
