<!-- views/superadmin/index.ejs -->
<%- include('../partials/header') %>
<h1 class="text-2xl font-bold mb-2">Super Administrador</h1>
<div class="mb-4">
  <a href="/admin/import-db" class="bg-amber-600 hover:bg-amber-700 text-white px-3 py-2 rounded text-sm">Importar base de datos local</a>
</div>
<p class="text-gray-500 mb-6 text-sm">Vista global de todos los negocios registrados. Solo accesible por dragoneik2010@gmail.com.</p>

<div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
  <div class="bg-white rounded-lg shadow p-4">
    <div class="text-sm text-gray-500">Negocios registrados</div>
    <div class="text-3xl font-bold text-blue-600"><%= tenants.length %></div>
  </div>
  <div class="bg-white rounded-lg shadow p-4">
    <div class="text-sm text-gray-500">Usuarios totales</div>
    <div class="text-3xl font-bold text-green-600"><%= tenants.reduce((s,t)=>s+t.users.length,0) %></div>
  </div>
  <div class="bg-white rounded-lg shadow p-4">
    <div class="text-sm text-gray-500">Negocios con hoja</div>
    <div class="text-3xl font-bold text-amber-600"><%= tenants.filter(t=>t.spreadsheetId).length %></div>
  </div>
</div>

<div id="superadmin-table" class="bg-white rounded-lg shadow overflow-x-auto"
     hx-get="/superadmin" hx-select="#superadmin-table" hx-target="#superadmin-table" hx-swap="outerHTML" hx-trigger="every 20s[document.visibilityState=='visible' && !document.querySelector('input:focus,textarea:focus,select:focus')]">
  <table class="w-full text-sm">
    <thead class="bg-gray-50 text-gray-600">
      <tr>
        <th class="text-left p-2 sm:p-3">Negocio</th>
        <th class="text-left p-2 sm:p-3 hidden sm:table-cell">Slug</th>
        <th class="text-left p-2 sm:p-3">Usuarios</th>
        <th class="text-left p-2 sm:p-3 hidden sm:table-cell">Creado</th>
        <th class="text-left p-2 sm:p-3 hidden sm:table-cell">Hoja</th>
        <th class="p-2 sm:p-3"></th>
      </tr>
    </thead>
    <tbody>
      <% tenants.forEach(t => { %>
      <tr class="border-t hover:bg-gray-50">
        <td class="p-2 sm:p-3 font-medium"><%= t.name %></td>
        <td class="p-2 sm:p-3 text-gray-500 hidden sm:table-cell"><%= t.slug %></td>
        <td class="p-2 sm:p-3"><%= t.users.length %> (<%= t.users.filter(u=>u.role==='admin').length %> admin, <%= t.users.filter(u=>u.role==='operador').length %> op)</td>
        <td class="p-2 sm:p-3 hidden sm:table-cell"><%= (t.createdAt||'').slice(0,10) %></td>
        <td class="p-2 sm:p-3 text-gray-400 text-xs hidden sm:table-cell">Privada</td>
        <td class="p-2 sm:p-3 text-right flex flex-wrap gap-2">
          <a href="/superadmin/tenant/<%= t.id %>" class="text-blue-600 hover:underline text-xs">Ver / gestionar</a>
          <form action="/superadmin/tenant/<%= t.id %>/eliminar" method="POST" class="inline" onsubmit="return confirm('¿Eliminar negocio y todos sus usuarios? (la hoja de Sheets NO se borra)')">
            <button class="text-red-600 hover:underline text-xs">Eliminar</button>
          </form>
        </td>
      </tr>
      <% }) %>
      <% if (!tenants.length) { %><tr><td colspan="6" class="text-center text-gray-400 py-6">Sin negocios registrados</td></tr><% } %>
    </tbody>
  </table>
</div>
<%- include('../partials/footer') %>
