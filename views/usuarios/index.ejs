<!-- views/usuarios/index.ejs -->
<%- include('../partials/header') %>
<h1 class="text-2xl font-bold mb-4">Usuarios del negocio</h1>
<p class="text-gray-500 mb-4 text-sm">Invita usuarios por correo. Al iniciar sesión con Google con ese correo, se vinculan automáticamente a este negocio.</p>

<div class="bg-white rounded-lg shadow p-6 mb-6 max-w-2xl">
  <h2 class="font-semibold mb-3">Agregar usuario</h2>
  <form action="/usuarios" method="POST" class="grid grid-cols-1 sm:grid-cols-3 gap-2 sm:p-3">
    <input name="name" placeholder="Nombre" class="border rounded px-3 py-2" />
    <input type="email" name="email" required placeholder="correo@ejemplo.com" class="border rounded px-3 py-2" />
    <select name="role" class="border rounded px-3 py-2">
      <option value="operador">Operador</option>
      <option value="admin">Administrador</option>
    </select>
    <div class="md:col-span-3">
      <button class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded">Agregar</button>
    </div>
  </form>
</div>

<% if (invite) { %>
<div class="bg-blue-50 border border-blue-200 text-blue-800 px-4 py-3 rounded mb-6 text-sm">
  <% if (invite.sent) { %>
    <strong>Invitación enviada por correo</strong> a <%= invite.email %>.
  <% } else { %>
    <strong>No se pudo enviar correo</strong> (<%= invite.reason || 'SMTP no configurado' %>). Comparte este enlace manualmente:
  <% } %>
  <div class="mt-2 flex items-center gap-2">
    <input id="inviteLink" readonly value="<%= (process.env.APP_URL || 'http://localhost:' + (process.env.PORT||3000)) %>/auth/google" class="flex-1 border rounded px-2 py-1 text-xs bg-white" />
    <button onclick="navigator.clipboard.writeText(document.getElementById('inviteLink').value)" class="bg-blue-600 text-white px-3 py-1 rounded text-xs">Copiar</button>
  </div>
  <p class="mt-2 text-xs">El usuario debe iniciar sesión con Google usando el correo <strong><%= invite.email %></strong> para vincularse automáticamente.</p>
</div>
<% } %>

<div class="bg-white rounded-lg shadow overflow-x-auto">
  <table class="w-full text-sm">
    <thead class="bg-gray-50 text-gray-600">
      <tr>
        <th class="text-left p-2 sm:p-3">Nombre</th>
        <th class="text-left p-2 sm:p-3">Email</th>
        <th class="text-left p-2 sm:p-3">Rol</th>
        <th class="text-left p-2 sm:p-3 hidden sm:table-cell">Vinculado</th>
        <th class="p-2 sm:p-3"></th>
      </tr>
    </thead>
    <tbody>
      <% usuarios.forEach(u => { %>
      <tr class="border-t">
        <td class="p-2 sm:p-3">
          <form action="/usuarios/<%= u.id %>/editar" method="POST" class="flex flex-col sm:flex-row gap-2 items-stretch sm:items-center">
            <input name="name" value="<%= u.name %>" class="border rounded px-2 py-1 text-xs w-full sm:w-32" />
            <input type="email" name="email" value="<%= u.email %>" class="border rounded px-2 py-1 text-xs w-full sm:w-40" />
            <select name="role" class="border rounded px-2 py-1 text-xs">
              <option value="admin" <%= u.role==='admin'?'selected':'' %>>Administrador</option>
              <option value="operador" <%= u.role==='operador'?'selected':'' %>>Operador</option>
            </select>
            <button class="text-blue-600 hover:underline text-xs">Guardar</button>
          </form>
        </td>
        <td class="p-2 sm:p-3 text-gray-500"><%= u.email %></td>
        <td class="p-2 sm:p-3"><%= u.role %></td>
        <td class="p-2 sm:p-3 text-xs hidden sm:table-cell"><%= u.googleId ? 'Sí' : 'Pendiente' %></td>
        <td class="p-2 sm:p-3 text-right">
          <% if (u.id !== user.id) { %>
          <form action="/usuarios/<%= u.id %>/eliminar" method="POST" class="inline" onsubmit="return confirm('¿Eliminar usuario?')">
            <button class="text-red-600 hover:underline text-xs">Eliminar</button>
          </form>
          <% } else { %>
          <span class="text-gray-400 text-xs">(tú)</span>
          <% } %>
        </td>
      </tr>
      <% }) %>
      <% if (!usuarios.length) { %><tr><td colspan="5" class="text-center text-gray-400 py-6">Sin usuarios</td></tr><% } %>
    </tbody>
  </table>
</div>
<%- include('../partials/footer') %>
