<!-- views/login.ejs -->
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>CashFlow · Acceso</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    .gradient-bg { background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 50%, #1d4ed8 100%); }
  </style>
</head>
<body class="min-h-screen flex">
  <!-- Panel izquierdo: branding -->
  <div class="hidden lg:flex lg:w-1/2 gradient-bg text-white flex-col justify-between p-12">
    <div>
      <div class="flex items-center gap-2 sm:p-3">
        <div class="w-10 h-10 rounded-lg bg-white/20 flex items-center justify-center font-bold">CF</div>
        <span class="text-2xl font-bold">CashFlow</span>
      </div>
    </div>
    <div>
      <h1 class="text-4xl font-bold mb-4 leading-tight">Controla tu negocio desde una sola hoja de cálculo.</h1>
      <p class="text-blue-100 text-lg mb-8">Flujo de caja, proveedores, pedidos, ingresos, egresos e inventario — todo respaldado en Google Sheets, multi-negocio y multi-usuario.</p>
      <ul class="space-y-3 text-blue-100">
        <li class="flex items-center gap-2"><span class="w-2 h-2 rounded-full bg-green-400"></span>Dashboard con gráficos en tiempo real</li>
        <li class="flex items-center gap-2"><span class="w-2 h-2 rounded-full bg-green-400"></span>Inventario en vivo con alertas de stock mínimo</li>
        <li class="flex items-center gap-2"><span class="w-2 h-2 rounded-full bg-green-400"></span>Exportación a CSV y roles (admin / operador)</li>
        <li class="flex items-center gap-2"><span class="w-2 h-2 rounded-full bg-green-400"></span>Despliegue con Docker y auto-deploy vía GitHub</li>
      </ul>
    </div>
    <div class="text-blue-200 text-sm">© 2026 CashFlow · Tus datos, tu Google Drive</div>
  </div>

  <!-- Panel derecho: acceso -->
  <div class="w-full lg:w-1/2 flex items-center justify-center p-8 bg-gray-50">
    <div class="w-full max-w-md">
      <div class="lg:hidden flex items-center gap-2 sm:p-3 mb-8">
        <div class="w-10 h-10 rounded-lg bg-blue-600 flex items-center justify-center font-bold text-white">CF</div>
        <span class="text-2xl font-bold text-gray-800">CashFlow</span>
      </div>

      <h2 class="text-3xl font-bold text-gray-900 mb-2">Bienvenido</h2>
      <p class="text-gray-500 mb-8">Inicia sesión o crea tu cuenta para empezar.</p>

      <!-- Tabs -->
      <div class="flex border-b border-gray-200 mb-6">
        <button id="tab-login" class="flex-1 py-3 text-sm font-semibold text-blue-600 border-b-2 border-blue-600">Iniciar sesión</button>
        <button id="tab-register" class="flex-1 py-3 text-sm font-semibold text-gray-500 border-b-2 border-transparent hover:text-gray-700">Crear cuenta</button>
      </div>

      <div id="panel-login" class="space-y-4">
        <p class="text-sm text-gray-600">Accede con tu cuenta de Google. Si es tu primera vez, se creará automáticamente tu negocio y tu hoja de cálculo.</p>
        <a href="/auth/google" class="flex items-center justify-center gap-2 sm:p-3 w-full bg-white border border-gray-300 hover:bg-gray-100 text-gray-700 font-semibold py-3 px-4 rounded-lg shadow-sm transition">
          <svg class="w-5 h-5" viewBox="0 0 24 24"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg>
          Continuar con Google
        </a>
      </div>

      <div id="panel-register" class="space-y-4 hidden">
        <p class="text-sm text-gray-600">Crear una cuenta es gratis. Usamos tu cuenta de Google para vincular tu hoja de cálculo y mantener tus datos seguros.</p>
        <a href="/auth/google" class="flex items-center justify-center gap-2 sm:p-3 w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-4 rounded-lg shadow-sm transition">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="white"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 15l-5-5 1.41-1.41L11 14.17l6.59-6.59L19 9l-8 8z"/></svg>
          Crear cuenta con Google
        </a>
        <p class="text-xs text-gray-400 text-center">Al crear una cuenta aceptas que tus datos se almacenen en tu propio Google Drive.</p>
      </div>

      <div class="mt-8 pt-6 border-t border-gray-200 text-center text-xs text-gray-400">
        ¿Problemas para entrar? Verifica que el correo esté autorizado como usuario de prueba en Google Cloud.
      </div>
    </div>
  </div>

  <script>
    const tabLogin = document.getElementById('tab-login');
    const tabRegister = document.getElementById('tab-register');
    const panelLogin = document.getElementById('panel-login');
    const panelRegister = document.getElementById('panel-register');
    function showTab(tab) {
      if (tab === 'login') {
        tabLogin.classList.add('text-blue-600','border-blue-600');
        tabLogin.classList.remove('text-gray-500','border-transparent');
        tabRegister.classList.remove('text-blue-600','border-blue-600');
        tabRegister.classList.add('text-gray-500','border-transparent');
        panelLogin.classList.remove('hidden');
        panelRegister.classList.add('hidden');
      } else {
        tabRegister.classList.add('text-blue-600','border-blue-600');
        tabRegister.classList.remove('text-gray-500','border-transparent');
        tabLogin.classList.remove('text-blue-600','border-blue-600');
        tabLogin.classList.add('text-gray-500','border-transparent');
        panelRegister.classList.remove('hidden');
        panelLogin.classList.add('hidden');
      }
    }
    tabLogin.addEventListener('click', () => showTab('login'));
    tabRegister.addEventListener('click', () => showTab('register'));
  </script>
</body>
</html>
