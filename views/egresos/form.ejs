<!-- views/egresos/form.ejs -->
<%- include('../partials/header') %>
<h1 class="text-2xl font-bold mb-4">Nuevo egreso</h1>
<form action="<%= action %>" method="POST" class="bg-white rounded-lg shadow p-6 max-w-2xl space-y-4">
  <div class="grid grid-cols-2 gap-4">
    <div>
      <label class="block text-sm font-medium mb-1">Fecha</label>
      <input type="date" name="fecha" value="<%= new Date().toISOString().slice(0,10) %>" class="w-full border rounded px-3 py-2" />
    </div>
    <div>
      <label class="block text-sm font-medium mb-1">Monto *</label>
      <input type="number" step="0.01" name="monto" required class="w-full border rounded px-3 py-2" />
    </div>
  </div>
  <div>
    <label class="block text-sm font-medium mb-1">Concepto *</label>
    <input name="concepto" required class="w-full border rounded px-3 py-2" />
  </div>
  <div class="grid grid-cols-2 gap-4">
    <div>
      <label class="block text-sm font-medium mb-1">Categoría</label>
      <input name="categoria" placeholder="Inventario, Servicios, Nómina" class="w-full border rounded px-3 py-2" />
    </div>
    <div>
      <label class="block text-sm font-medium mb-1">Proveedor</label>
      <select name="proveedor" class="w-full border rounded px-3 py-2">
        <option value="">-- Ninguno --</option>
        <% proveedores.forEach(p => { %>
          <option value="<%= p.nombre %>"><%= p.nombre %></option>
        <% }) %>
      </select>
    </div>
  </div>
  <div>
    <label class="block text-sm font-medium mb-1">Notas</label>
    <textarea name="notas" rows="2" class="w-full border rounded px-3 py-2"></textarea>
  </div>
  <div class="flex gap-2">
    <button class="bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded">Guardar</button>
    <a href="/egresos" class="px-4 py-2 rounded border">Cancelar</a>
  </div>
</form>
<%- include('../partials/footer') %>
