<!-- views/egresos/index.ejs -->
<%- include('../partials/header') %>
<div class="flex items-center justify-between mb-4">
  <h1 class="text-2xl font-bold">Egresos</h1>
  <div class="space-x-2">
    <a href="/export/egresos" class="bg-gray-600 hover:bg-gray-700 text-white px-3 py-2 rounded text-sm">Exportar CSV</a>
    <a href="/egresos/nuevo" class="bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded">+ Nuevo</a>
  </div>
</div>
<div id="egresos-table" class="bg-white rounded-lg shadow overflow-x-auto"
     hx-get="/egresos" hx-select="#egresos-table" hx-target="#egresos-table" hx-swap="outerHTML" hx-trigger="every 20s[document.visibilityState=='visible']">
  <table class="w-full text-sm">
    <thead class="bg-gray-50 text-gray-600">
      <tr>
        <th class="text-left p-3">Fecha</th>
        <th class="text-left p-3">Concepto</th>
        <th class="text-left p-3">Categoría</th>
        <th class="text-left p-3">Proveedor</th>
        <th class="text-right p-3">Monto</th>
        <th class="p-3"></th>
      </tr>
    </thead>
    <tbody>
      <% egresos.forEach(e => { %>
      <tr class="border-t hover:bg-gray-50">
        <td class="p-3"><%= e.fecha %></td>
        <td class="p-3"><%= e.concepto %></td>
        <td class="p-3"><%= e.categoria %></td>
        <td class="p-3"><%= e.proveedor %></td>
        <td class="p-3 text-right text-red-600 font-medium"><%= money(e.monto) %></td>
        <td class="p-3 text-right">
          <form action="/egresos/<%= e._row %>" method="POST" class="inline" onsubmit="return confirm('¿Eliminar egreso?')">
            <input type="hidden" name="_method" value="DELETE" />
            <button class="text-red-600 hover:underline">Eliminar</button>
          </form>
        </td>
      </tr>
      <% }) %>
      <% if (!egresos.length) { %><tr><td colspan="6" class="text-center text-gray-400 py-6">Sin egresos</td></tr><% } %>
    </tbody>
  </table>
</div>
<%- include('../partials/footer') %>
