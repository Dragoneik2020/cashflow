<!-- views/flujo.ejs -->
<%- include('partials/header') %>
<div class="flex items-center justify-between mb-4">
  <h1 class="text-2xl font-bold">Flujo de caja</h1>
  <a href="/export/flujo" class="bg-gray-600 hover:bg-gray-700 text-white px-3 py-2 rounded text-sm">Exportar CSV</a>
</div>
<div id="flujo-table" class="bg-white rounded-lg shadow overflow-x-auto"
     hx-get="/flujo" hx-select="#flujo-table" hx-target="#flujo-table" hx-swap="outerHTML" hx-trigger="every 20s[document.visibilityState=='visible']">
  <table class="w-full text-sm">
    <thead class="bg-gray-50 text-gray-600">
      <tr>
        <th class="text-left p-3">Fecha</th>
        <th class="text-left p-3">Tipo</th>
        <th class="text-left p-3">Concepto</th>
        <th class="text-right p-3">Monto</th>
        <th class="text-right p-3">Saldo acumulado</th>
      </tr>
    </thead>
    <tbody>
      <% movs.forEach(m => { %>
      <tr class="border-t">
        <td class="p-3"><%= m.fecha %></td>
        <td class="p-3 <%= m.tipo==='Ingreso'?'text-green-600':'text-red-600' %>"><%= m.tipo %></td>
        <td class="p-3"><%= m.concepto %></td>
        <td class="p-3 text-right <%= m.monto>=0?'text-green-600':'text-red-600' %>"><%= money(m.monto) %></td>
        <td class="p-3 text-right font-medium"><%= money(m.saldo) %></td>
      </tr>
      <% }) %>
      <% if (!movs.length) { %><tr><td colspan="5" class="text-center text-gray-400 py-6">Sin movimientos</td></tr><% } %>
    </tbody>
  </table>
</div>
<%- include('partials/footer') %>
