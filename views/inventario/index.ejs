<!-- views/inventario/index.ejs -->
<%- include('../partials/header') %>
<div class="flex items-center justify-between mb-4">
  <h1 class="text-2xl font-bold">Inventario</h1>
  <div class="flex flex-wrap gap-2">
    <a href="/export/inventario" class="bg-gray-600 hover:bg-gray-700 text-white px-3 py-2 rounded text-sm">Exportar CSV</a>
    <a href="/inventario/importar" class="bg-amber-600 hover:bg-amber-700 text-white px-3 py-2 rounded text-sm">Importar CSV</a>
    <a href="/inventario/nuevo" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded">+ Nuevo</a>
  </div>
</div>
<div id="inventario-content" hx-get="/inventario" hx-select="#inventario-content" hx-target="#inventario-content" hx-swap="outerHTML" hx-trigger="every 20s[document.visibilityState=='visible' && !document.querySelector('input:focus,textarea:focus,select:focus')]">
<div class="bg-white rounded-lg shadow overflow-x-auto mb-6">
  <table class="w-full text-sm">
    <thead class="bg-gray-50 text-gray-600">
      <tr>
        <th class="text-left p-3">Producto</th>
        <th class="text-left p-3">Categoría</th>
        <th class="text-right p-3">Stock</th>
        <th class="text-left p-3">Unidad</th>
        <th class="text-right p-3">Mínimo</th>
        <th class="text-right p-3">P. Costo</th>
        <th class="text-right p-3">P. Venta</th>
        <th class="text-left p-3">Proveedor</th>
        <th class="p-3"></th>
      </tr>
    </thead>
    <tbody>
      <% items.forEach(i => { %>
      <tr class="border-t hover:bg-gray-50 <%= (parseFloat(i.cantidad)||0) <= (parseFloat(i.stockMinimo)||0) ? 'bg-red-50' : '' %>">
        <td class="p-3 font-medium"><%= i.producto %></td>
        <td class="p-3"><%= i.categoria %></td>
        <td class="p-3 text-right font-bold <%= (parseFloat(i.cantidad)||0) <= (parseFloat(i.stockMinimo)||0) ? 'text-red-600' : 'text-green-600' %>"><%= i.cantidad %></td>
        <td class="p-3"><%= i.unidad %></td>
        <td class="p-3 text-right"><%= i.stockMinimo %></td>
        <td class="p-3 text-right"><%= money(i.precioCosto) %></td>
        <td class="p-3 text-right"><%= money(i.precioVenta) %></td>
        <td class="p-3"><%= i.proveedor %></td>
        <td class="p-3 text-right space-x-2">
          <form action="/inventario/<%= i._row %>/movimiento" method="POST" class="inline">
            <input type="hidden" name="tipo" value="Entrada" />
            <input type="number" step="0.01" name="cantidad" placeholder="cant" class="border rounded px-1 py-0.5 w-16 text-xs" required />
            <input type="text" name="motivo" placeholder="motivo" class="border rounded px-1 py-0.5 w-20 text-xs" />
            <button class="text-green-600 hover:underline text-xs">+Entrada</button>
          </form>
          <form action="/inventario/<%= i._row %>/movimiento" method="POST" class="inline">
            <input type="hidden" name="tipo" value="Salida" />
            <input type="number" step="0.01" name="cantidad" placeholder="cant" class="border rounded px-1 py-0.5 w-16 text-xs" required />
            <input type="text" name="motivo" placeholder="motivo" class="border rounded px-1 py-0.5 w-20 text-xs" />
            <button class="text-red-600 hover:underline text-xs">-Salida</button>
          </form>
          <a href="/inventario/<%= i._row %>/edit" class="text-blue-600 hover:underline text-xs">Editar</a>
          <% if (user.role === 'admin') { %>
          <form action="/inventario/<%= i._row %>" method="POST" class="inline" onsubmit="return confirm('¿Eliminar producto?')">
            <input type="hidden" name="_method" value="DELETE" />
            <button class="text-red-600 hover:underline text-xs">Eliminar</button>
          </form>
          <% } %>
        </td>
      </tr>
      <% }) %>
      <% if (!items.length) { %><tr><td colspan="9" class="text-center text-gray-400 py-6">Sin productos</td></tr><% } %>
    </tbody>
  </table>
</div>

<h2 class="font-semibold mb-2">Últimos movimientos</h2>
<div class="bg-white rounded-lg shadow overflow-x-auto">
  <table class="w-full text-sm">
    <thead class="bg-gray-50 text-gray-600">
      <tr><th class="text-left p-3">Fecha</th><th class="text-left p-3">Producto</th><th class="text-left p-3">Tipo</th><th class="text-right p-3">Cantidad</th><th class="text-left p-3">Motivo</th></tr>
    </thead>
    <tbody>
      <% movimientos.forEach(m => { %>
      <tr class="border-t">
        <td class="p-3"><%= m.fecha %></td>
        <td class="p-3"><%= m.producto %></td>
        <td class="p-3 <%= m.tipo==='Entrada'?'text-green-600':'text-red-600' %>"><%= m.tipo %></td>
        <td class="p-3 text-right"><%= m.cantidad %></td>
        <td class="p-3"><%= m.motivo %></td>
      </tr>
      <% }) %>
      <% if (!movimientos.length) { %><tr><td colspan="5" class="text-center text-gray-400 py-6">Sin movimientos</td></tr><% } %>
    </tbody>
  </table>
</div>
</div>
<%- include('../partials/footer') %>
