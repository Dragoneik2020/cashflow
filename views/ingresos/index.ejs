<!-- views/ingresos/index.ejs -->
<%- include('../partials/header') %>
<div class="flex items-center justify-between mb-4">
  <h1 class="text-2xl font-bold">Ingresos</h1>
  <div class="space-x-2">
    <a href="/export/ingresos" class="bg-gray-600 hover:bg-gray-700 text-white px-3 py-2 rounded text-sm">Exportar CSV</a>
    <a href="/ingresos/nuevo" class="bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded">+ Nuevo</a>
  </div>
</div>
<div id="ingresos-table" class="bg-white rounded-lg shadow overflow-x-auto"
     hx-get="/ingresos" hx-select="#ingresos-table" hx-target="#ingresos-table" hx-swap="outerHTML" hx-trigger="every 20s[document.visibilityState=='visible']">
  <table class="w-full text-sm">
    <thead class="bg-gray-50 text-gray-600">
      <tr>
        <th class="text-left p-3">Fecha</th>
        <th class="text-left p-3">Concepto</th>
        <th class="text-left p-3">Categoría</th>
        <th class="text-left p-3">Fuente</th>
        <th class="text-right p-3">Monto</th>
        <th class="p-3"></th>
      </tr>
    </thead>
    <tbody>
      <% ingresos.forEach(i => { %>
      <tr class="border-t hover:bg-gray-50">
        <td class="p-3"><%= i.fecha %></td>
        <td class="p-3"><%= i.concepto %></td>
        <td class="p-3"><%= i.categoria %></td>
        <td class="p-3"><%= i.fuente %></td>
        <td class="p-3 text-right text-green-600 font-medium"><%= money(i.monto) %></td>
        <td class="p-3 text-right">
          <form action="/ingresos/<%= i._row %>" method="POST" class="inline" onsubmit="return confirm('¿Eliminar ingreso?')">
            <input type="hidden" name="_method" value="DELETE" />
            <button class="text-red-600 hover:underline">Eliminar</button>
          </form>
        </td>
      </tr>
      <% }) %>
      <% if (!ingresos.length) { %><tr><td colspan="6" class="text-center text-gray-400 py-6">Sin ingresos</td></tr><% } %>
    </tbody>
  </table>
</div>
<%- include('../partials/footer') %>
