# Google OAuth 2.0 (crea credenciales en https://console.cloud.google.com)
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Sesión
SESSION_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria

# Puerto
PORT=3000

# (Opcional) URL pública en producción
APP_URL=http://localhost:3000

# (Opcional) SMTP para enviar invitaciones por correo
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=tu-correo@gmail.com
# SMTP_PASS=tu-app-password
# SMTP_FROM=tu-correo@gmail.com
